{
  // Northbid: offer page at /, the tender & RFQ engine at /app. One Worker, one D1 database.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tender-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tender-engine",
      // Replace with the id from `npx wrangler d1 create tender-engine`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Pull new tenders from TED and UK Find a Tender every 6 hours.
  "triggers": { "crons": ["17 */6 * * *"] },
  // Secrets (wrangler secret put): APP_PASSWORD, SESSION_SECRET, ANTHROPIC_API_KEY (optional), LEAD_WEBHOOK_URL (optional)
  "vars": { "BOOKING_URL": "" }
}
