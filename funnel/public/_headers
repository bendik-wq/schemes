# Static assets (served without the Worker). Pages, the Worker's own headers and the CSP live in src/index.ts.
#
# Caching rules:
# - css/js used by the funnel pages are always referenced as ?v=<deployed version> (renderTemplate), so they are
#   cached for a year. Never reference them without the version.
# - fonts and the flow ribbons are cached for a year by filename: give a changed file a new name.
# - admin assets stay short-lived (Funnel HQ loads them without a version).
# Each rule sets Cache-Control once: several matching rules would join their values with a comma.

/assets/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/assets/flow/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/assets/site.css
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/assets/form.css
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

